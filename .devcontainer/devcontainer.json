{
    "name": "ComfyUI DevEnv",
    // ComfyUI は compose の comfyui サービスとして常駐している。VS Code はそこに入るだけ
    "dockerComposeFile": "../docker-compose.yml",
    "service": "comfyui",
    "runServices": ["comfyui"],
    "workspaceFolder": "/workspaces/comfyui-devenv",
    // compose の command（ComfyUI の起動）を sleep に置き換えない
    "overrideCommand": false,
    // VS Code を閉じても ComfyUI を止めない
    "shutdownAction": "none",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            }
        }
    }
}
